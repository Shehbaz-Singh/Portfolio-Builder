{
  "name": "portfolio-generator",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "npm run build -w @portfolio/shared",
    "dev:shared": "npm run dev -w @portfolio/shared",
    "dev:backend": "npm run dev -w @portfolio/backend",
    "dev:frontend": "npm run dev -w @portfolio/frontend",
    "dev": "npm run build:shared && concurrently -n shared,backend,frontend -c gray,cyan,magenta \"npm:dev:shared\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build:shared && npm run build -w @portfolio/backend && npm run build -w @portfolio/frontend",
    "typecheck": "npm run build:shared && npm run typecheck -w @portfolio/backend && npm run typecheck -w @portfolio/frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
