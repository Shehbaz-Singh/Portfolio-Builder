# Base URL of the Express API
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this site (absolute Open Graph and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-only. Same value as PROXY_SECRET in backend/.env (32+ characters), so the
# API can rate limit real visitors instead of this server.
# PROXY_SECRET=
