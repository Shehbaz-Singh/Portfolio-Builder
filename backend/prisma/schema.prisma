generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum TestimonialStatus {
  pending
  approved
  rejected
}

enum AvailabilityStatus {
  open_to_work
  open_to_freelance
  open_to_collaborate
  custom
}

enum LinkType {
  linkedin
  github
  email
  phone
  website
  other
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  profile      Profile?
}

model Profile {
  id                  String             @id @default(cuid())
  userId              String             @unique
  slug                String             @unique
  fullName            String
  tagline             String?
  about               String?
  location            String?
  avatarUrl           String?
  theme               String             @default("editorial")
  accentColor         String             @default("#2563eb")
  published           Boolean            @default(false)
  // Whether visitors may submit testimonials (POST /public/:slug/testimonials).
  acceptTestimonials  Boolean            @default(false)
  // The availability badge on the public page (see shared/src/availability.ts).
  availabilityEnabled Boolean            @default(false)
  availabilityStatus  AvailabilityStatus @default(open_to_work)
  availabilityMessage String?            @db.VarChar(140)
  // Order, visibility and headings of the page sections (see shared/src/section-config.ts).
  // The default must match defaultSectionConfig(); existing rows get it when the column is added.
  sectionConfig       Json               @default("[{\"key\":\"about\",\"visible\":true},{\"key\":\"skills\",\"visible\":true},{\"key\":\"experience\",\"visible\":true},{\"key\":\"projects\",\"visible\":true},{\"key\":\"education\",\"visible\":true},{\"key\":\"testimonials\",\"visible\":false}]")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  links          Link[]
  skills         Skill[]
  experience     Experience[]
  projects       Project[]
  education      Education[]
  customSections CustomSection[]
  testimonials   Testimonial[]
}

model Link {
  id        String   @id @default(cuid())
  profileId String
  type      LinkType
  url       String
  visible   Boolean  @default(true)
  order     Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Skill {
  id        String @id @default(cuid())
  profileId String
  name      String
  order     Int    @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Experience {
  id          String    @id @default(cuid())
  profileId   String
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime?
  description String
  order       Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Project {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  url         String?
  description String
  techTags    String[]
  order       Int      @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Education {
  id          String    @id @default(cuid())
  profileId   String
  degree      String
  institution String
  startDate   DateTime
  endDate     DateTime?
  order       Int       @default(0)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

// A section the user made up (Certifications, Awards, ...). Its place on the page is held in
// Profile.sectionConfig under the key "custom:<id>"; `order` and `visible` mirror that entry
// and are kept in step with it by the service, so they can be read without parsing the JSON.
model CustomSection {
  id        String  @id @default(cuid())
  profileId String
  title     String
  order     Int     @default(0)
  visible   Boolean @default(true)

  profile Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  items   CustomSectionItem[]

  @@index([profileId])
}

model CustomSectionItem {
  id          String    @id @default(cuid())
  sectionId   String
  title       String
  subtitle    String?
  startDate   DateTime?
  endDate     DateTime?
  url         String?
  description String?
  order       Int       @default(0)

  section CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// A quote about the profile's owner, submitted by a visitor (pending until approved) or added by
// the owner (approved at once). `contactEmail` is for the owner and is never sent to visitors.
// `order` ranks the approved ones on the page.
model Testimonial {
  id            String            @id @default(cuid())
  profileId     String
  authorName    String
  authorRole    String?
  authorCompany String?
  message       String
  contactEmail  String?
  status        TestimonialStatus @default(pending)
  order         Int               @default(0)
  createdAt     DateTime          @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, status])
}
