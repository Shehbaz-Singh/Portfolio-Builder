NODE_ENV=development
PORT=4000
# Origin of the Next.js frontend (used for CORS)
FRONTEND_URL=http://localhost:3000
# Neon pooled connection string (hostname contains -pooler). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct (non-pooled) connection string. Used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# Secret used to sign JWTs (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Token lifetime: number + unit (s, m, h, d)
JWT_EXPIRES_IN=7d
