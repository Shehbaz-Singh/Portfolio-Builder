NODE_ENV=development
PORT=4000
# Origin of the Next.js frontend (used for CORS)
FRONTEND_URL=http://localhost:3000
# Neon pooled connection string (hostname contains -pooler). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
# Neon direct (non-pooled) connection string. Used by Prisma CLI for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
# Secret used to sign JWTs (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string
# Token lifetime: number + unit (s, m, h, d)
JWT_EXPIRES_IN=7d
# Optional. Same value as PROXY_SECRET in frontend/.env.local (32+ characters). Makes rate
# limits count real visitors instead of the frontend server. Generate like JWT_SECRET.
# PROXY_SECRET=

# Resume import and "Suggest translation" in the Languages page (optional). Both use this one
# model. Without LLM_API_KEY they are simply unavailable.
# Gemini has a free tier (key from https://aistudio.google.com/apikey), but Google may use
# free-tier content to improve its products. Resumes are personal data: use a paid key or
# another provider before real users upload theirs.
# LLM_PROVIDER=gemini    # gemini (default), or openai (also any OpenAI-compatible server)
# LLM_API_KEY=
# LLM_MODEL=             # default: gemini-3.5-flash-lite, or gpt-4o-mini for openai
# LLM_BASE_URL=          # only for an OpenAI-compatible server that is not OpenAI

# Cloudinary (avatar uploads). Copy these from the Cloudinary dashboard > API Keys.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
